# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
# Local quick-start (no server needed): sqlite file, already the default.
# Switch to Postgres once Docker is running: postgresql+psycopg2://medassist:medassist@localhost:5432/medassist
DATABASE_URL=sqlite:///./medassist.db

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File storage ---
UPLOAD_DIR=./uploads

# --- AI provider (phase 4/5) ---
# Leave blank for now -- the AI service layer falls back to a stub
# (mock, clearly-labeled) summary so the rest of the app is testable
# without an API key. Fill in later, provider="stub" | "openai" | "anthropic".
AI_PROVIDER=stub
AI_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
